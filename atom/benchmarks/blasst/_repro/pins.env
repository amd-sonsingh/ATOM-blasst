# Everything the reproduction is pinned to. Sourced by the scripts here and
# baked into the image, so a number can always be traced to exact code.
#
# Re-pin deliberately, never incidentally: AITER_PR_COMMIT moves every time the
# aiter PR takes review feedback, and "check out the PR branch" would silently
# measure different kernel code from one week to the next.

# aiter carrying block_skip_threshold on unified_attention. NOT merged, so it is
# fetched from the pull-request ref on ROCm/aiter rather than from a branch --
# the branch itself lives on a contributor fork and is not fetchable by name.
AITER_REPO=https://github.com/ROCm/aiter.git
AITER_PR=5868
AITER_PR_COMMIT=47c2b1dc36e7aa977a6fb35140ea3c134c528cd6

# Triton, pinned and patched. See docker/Dockerfile for why the patch exists.
TRITON_REPO=https://github.com/triton-lang/triton.git
TRITON_COMMIT=71d121b0690ad2615f19c85a1c29b08b55a9f80e

IMAGE=atom-blasst/repro:rocm7.2.4-py3.12-torch2.10.0

# The calibrated threshold the reference numbers use: Qwen3-8B, 50% target
# sparsity, 32K context, from alpha=7.4142 beta=9.6915.
THRESHOLD=0.02878

# The reference sweep was timed at these, NOT the benchmark's 5/20 defaults.
BLASST_BENCH_WARMUP=3
BLASST_BENCH_REPEAT=10
